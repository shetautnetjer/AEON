+def admit_interpretation(db_path, *, project_id, profile_id, evidence_event,
+                         supersedes_event_id=None, allow_content=False):
+    """Append supplied immutable EvidenceEvent; no semantic truth or promotion."""
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    scope = _reference_scope(project_id, profile_id)
+    body = _reference_json(evidence_event, 'event_id', 'EVIDENCE_EVENT')
+    normalization = evidence_event.get('normalization')
+    if (not isinstance(normalization, dict) or
+            not isinstance(normalization.get('derived_from_event_ids'), list) or
+            len(normalization['derived_from_event_ids']) != 1 or
+            not isinstance(normalization['derived_from_event_ids'][0], str) or
+            not _UUID7.fullmatch(normalization['derived_from_event_ids'][0]) or
+            not isinstance(evidence_event.get('correlation'), dict) or
+            (supersedes_event_id is not None and
+             (not isinstance(supersedes_event_id, str) or not _UUID7.fullmatch(supersedes_event_id)))):
+        raise ValueError('reference_interpretation_invalid')
+    source_id = normalization['derived_from_event_ids'][0]
+    con = _connect(db_path, require_existing=True)
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        _reference_tables(con)
+        source = con.execute('''SELECT artifact_json FROM reference_sources
+            WHERE project_id=? AND profile_id=? AND event_id=?''', (*scope, source_id)).fetchone()
+        if not source or evidence_event.get('artifact_ids') != [json.loads(source[0])['artifact_id']]:
+            raise ValueError('reference_source_missing')
+        if con.execute('''SELECT 1 FROM reference_sources WHERE project_id=?
+                AND profile_id=? AND event_id=?''', (*scope, evidence_event['event_id'])).fetchone():
+            raise ValueError('reference_event_id_conflict')
+        fields = (*scope, evidence_event['event_id'], source_id, body, supersedes_event_id)
+        prior = con.execute('''SELECT * FROM reference_interpretations
+            WHERE project_id=? AND profile_id=? AND event_id=?''',
+            (*scope, evidence_event['event_id'])).fetchone()
+        if prior == fields:
+            state = 'replayed'
+        elif prior:
+            raise ValueError('reference_interpretation_changed')
+        else:
+            if supersedes_event_id is not None:
+                predecessor = con.execute('''SELECT source_event_id FROM reference_interpretations
+                    WHERE project_id=? AND profile_id=? AND event_id=?''',
+                    (*scope, supersedes_event_id)).fetchone()
+                successor = con.execute('''SELECT 1 FROM reference_interpretations
+                    WHERE project_id=? AND profile_id=? AND supersedes_event_id=?''',
+                    (*scope, supersedes_event_id)).fetchone()
+                if predecessor != (source_id,) or successor:
+                    raise ValueError('reference_lineage_invalid')
+            con.execute('INSERT INTO reference_interpretations VALUES(?,?,?,?,?,?)', fields)
+            state = 'new'
+        con.commit()
+        return {'state': state, 'status': 'candidate_interpretation'}
+    except Exception:
+        con.rollback()
+        raise
+    finally:
+        con.close()
+
