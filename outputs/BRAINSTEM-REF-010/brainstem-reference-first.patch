+use brainstem_observer_probe::admission::accept_fixture;
+use serde_json::{json, Value};
+use std::{
+    fs,
+    io::Write,
+    path::PathBuf,
+    process::{Command, Stdio},
+};
+
+struct Fixture(PathBuf);
+impl Fixture {
+    fn new() -> Self {
+        let p = std::env::temp_dir().join(format!("brainstem-admission-{}", uuid::Uuid::now_v7()));
+        fs::create_dir(&p).unwrap();
+        Self(p)
+    }
+    fn journal(&self) -> PathBuf {
+        self.0.join("source.ndjson")
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+fn request() -> Value {
+    let generation = "a".repeat(64);
+    json!({"fixture_only":true,"source_path":"/fixture/state.db",
+      "captured_record":{"source_key":format!("default/hermes/{generation}/session-A/messages/1"),
+        "envelope":{"profile_id":"default","source":{"producer_id":"hermes",
+         "source_generation_id":generation,"source_instance_id":"session-A",
+         "source_stream_id":"messages","source_position":"1","native_event_id":"1"},
+         "semantics":{},"payload":{},"evidence_refs":[],"correlation":{"session_id":"session-A"},
+         "capture":{"record_sha256":"b".repeat(64),"captured_at":100.0}}},
+      "source_event":{"record_kind":"SOURCE_EVENT","schema_version":"0.2",
+        "event_type":"fixture.hermes.message","source_context_class":"PRE_OBSERVER_SOURCE_CONTEXT",
+        "capture_mode":"HISTORICAL_IMPORT",
+        "source":{"source_id":"hermes","source_kind":"HERMES","source_instance_id":generation,
+          "source_stream_id":"messages","sequence_epoch":"fixture-epoch-A",
+          "native_event_id":"1","source_position":{"position_kind":"ROW_PRIMARY_KEY",
+            "row_primary_key":"1","locator":"/fixture/state.db"},
+          "adapter_id":"fixture-hermes","adapter_version":"0.1"},
+        "origin":{},"correlation":{"session_id":"session-A","runtime_profile_id":"default"},
+        "coverage":{"status":"PARTIAL","gap_refs":[],"limitations":["fixture-only selected metadata"]},
+        "time":{"observed_at":"1970-01-01T00:01:40Z"},
+        "capture":{"capture_policy":"NORMAL","content_disposition":"METADATA_ONLY"},
+        "artifact_ids":[],"payload":{"record_sha256":"b".repeat(64)},
+        "observer":{"observer_instance_id":"fixture-writer-generation-A",
+          "writer_actor_id":"fixture-service-actor","writer_authority_receipt_ref":"fixture:writer-authority"}}})
+}
+fn cli(journal: &std::path::Path, req: &Value, fault: Option<&str>) -> std::process::Output {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_brainstem-observer-probe"));
+    cmd.args(["--admit-capture-fixture", "--journal"])
+        .arg(journal);
+    if let Some(f) = fault {
+        cmd.env("BRAINSTEM_FIXTURE_CRASH", f);
+    }
+    let mut child = cmd
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(req.to_string().as_bytes())
+        .unwrap();
+    child.wait_with_output().unwrap()
+}
+#[test]
+fn retry_reopen_retains_canonical_event_and_writer() {
+    let f = Fixture::new();
+    let req = request();
+    let first = accept_fixture(&f.journal(), &req).unwrap();
+    let replay = cli(&f.journal(), &req, None);
+    assert!(replay.status.success());
+    let replay: Value = serde_json::from_slice(&replay.stdout).unwrap();
+    assert_eq!(replay["state"], "replayed");
+    assert_eq!(first["source_event"], replay["source_event"]);
+    let event = &first["source_event"];
+    assert_eq!(
+        uuid::Uuid::parse_str(event["event_id"].as_str().unwrap())
+            .unwrap()
+            .get_version_num(),
+        7
+    );
+    assert_eq!(event["observer"]["observer_sequence"], 1);
+    assert_eq!(event["record_kind"], "SOURCE_EVENT");
+    assert_eq!(fs::read_to_string(f.journal()).unwrap().lines().count(), 1);
+}
+#[test]
+fn generation_epoch_and_equal_content_occurrences_are_distinct() {
+    let f = Fixture::new();
+    let req = request();
+    let a = accept_fixture(&f.journal(), &req).unwrap();
+    let mut epoch = req.clone();
+    epoch["source_event"]["source"]["sequence_epoch"] = json!("fixture-epoch-B");
+    let b = accept_fixture(&f.journal(), &epoch).unwrap();
+    let mut generation = req.clone();
+    let gen = "c".repeat(64);
+    generation["source_event"]["source"]["source_instance_id"] = json!(gen);
+    generation["captured_record"]["envelope"]["source"]["source_generation_id"] = json!(gen);
+    generation["captured_record"]["source_key"] =
+        json!(format!("default/hermes/{gen}/session-A/messages/1"));
+    let c = accept_fixture(&f.journal(), &generation).unwrap();
+    let mut row = req.clone();
+    row["source_event"]["source"]["native_event_id"] = json!("2");
+    row["source_event"]["source"]["source_position"]["row_primary_key"] = json!("2");
+    row["captured_record"]["envelope"]["source"]["native_event_id"] = json!("2");
+    row["captured_record"]["envelope"]["source"]["source_position"] = json!("2");
+    row["captured_record"]["source_key"] = json!(format!(
+        "default/hermes/{}/session-A/messages/2",
+        "a".repeat(64)
+    ));
+    let d = accept_fixture(&f.journal(), &row).unwrap();
+    let ids = [a, b, c, d].map(|x| x["source_event"]["event_id"].as_str().unwrap().to_owned());
+    assert_eq!(
+        ids.iter().collect::<std::collections::HashSet<_>>().len(),
+        4
+    );
+}
+#[test]
+fn incompatible_rebinding_is_rejected_without_new_frame() {
+    let f = Fixture::new();
+    let req = request();
+    accept_fixture(&f.journal(), &req).unwrap();
+    let before = fs::read(f.journal()).unwrap();
+    for changed in ["payload", "locator", "writer", "correlation"] {
+        let mut r = req.clone();
+        match changed {
+            "payload" => {
+                r["source_event"]["payload"]["record_sha256"] = json!("c".repeat(64));
+                r["captured_record"]["envelope"]["capture"]["record_sha256"] =
+                    json!("c".repeat(64));
+            }
+            "locator" => {
+                r["source_event"]["source"]["source_position"]["locator"] =
+                    json!("/fixture/changed.db");
+                r["source_path"] = json!("/fixture/changed.db");
+            }
+            "writer" => {
+                r["source_event"]["observer"]["writer_authority_receipt_ref"] =
+                    json!("fixture:different-authority")
+            }
+            _ => r["source_event"]["correlation"]["trace_id"] = json!("different-trace"),
+        }
+        assert!(accept_fixture(&f.journal(), &r).is_err(), "{changed}");
+        assert_eq!(before, fs::read(f.journal()).unwrap());
+    }
+}
+#[test]
+fn crash_windows_never_duplicate_an_accepted_occurrence() {
+    for stage in [
+        "before_append",
+        "partial_frame",
+        "after_append",
+        "after_sync",
+    ] {
+        let f = Fixture::new();
+        let req = request();
+        let crashed = cli(&f.journal(), &req, Some(stage));
+        assert_eq!(crashed.status.code(), Some(86));
+        let saved = fs::read(f.journal()).unwrap();
+        let prior: Option<Value> = if saved.last() == Some(&b'\n') {
+            Some(serde_json::from_slice::<Value>(&saved).unwrap()["source_event"].clone())
+        } else {
+            None
+        };
+        let recovered = accept_fixture(&f.journal(), &req).unwrap();
+        if let Some(prior) = prior {
+            assert_eq!(recovered["source_event"], prior);
+        }
+        assert_eq!(
+            accept_fixture(&f.journal(), &req).unwrap()["state"],
+            "replayed"
+        );
+        assert_eq!(fs::read_to_string(f.journal()).unwrap().lines().count(), 1);
+    }
+}
+#[test]
+fn incomplete_tail_is_recovered_but_corrupt_complete_frame_is_not_rewritten() {
+    let f = Fixture::new();
+    let req = request();
+    let first = accept_fixture(&f.journal(), &req).unwrap();
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(f.journal())
+        .unwrap();
+    file.write_all(b"{partial").unwrap();
+    drop(file);
+    assert_eq!(
+        accept_fixture(&f.journal(), &req).unwrap()["source_event"],
+        first["source_event"]
+    );
+    let mut file = fs::OpenOptions::new()
+        .append(true)
+        .open(f.journal())
+        .unwrap();
+    file.write_all(b"{invalid}\n").unwrap();
+    drop(file);
+    let before = fs::read(f.journal()).unwrap();
+    assert!(accept_fixture(&f.journal(), &req).is_err());
+    assert_eq!(before, fs::read(f.journal()).unwrap());
+}
+#[test]
+fn input_must_bind_native_coordinates_and_distinct_fixture_writer_provenance() {
+    let f = Fixture::new();
+    for mode in ["fixture", "generation", "actor", "sequence", "id"] {
+        let mut req = request();
+        match mode {
+            "fixture" => req["fixture_only"] = json!(false),
+            "generation" => req["source_event"]["source"]["source_instance_id"] = json!("wrong"),
+            "actor" => {
+                req["source_event"]["correlation"]["actor_id"] = json!("fixture-service-actor")
+            }
+            "sequence" => req["source_event"]["observer"]["observer_sequence"] = json!(999),
+            _ => req["source_event"]["event_id"] = json!("caller-id"),
+        }
+        assert!(accept_fixture(&f.journal(), &req).is_err());
+        assert!(!f.journal().exists());
+    }
+}
+#[test]
+fn concurrent_callers_either_replay_or_retry_the_same_accepted_id() {
+    let f = Fixture::new();
+    let req = request();
+    let path = f.journal();
+    let left = path.clone();
+    let a = req.clone();
+    let thread = std::thread::spawn(move || cli(&left, &a, None));
+    let right = cli(&path, &req, None);
+    let left = thread.join().unwrap();
+    let durable = accept_fixture(&path, &req).unwrap();
+    for output in [left, right] {
+        if output.status.success() {
+            let receipt: Value = serde_json::from_slice(&output.stdout).unwrap();
+            assert_eq!(receipt["source_event"], durable["source_event"]);
+        } else {
+            assert_eq!(
