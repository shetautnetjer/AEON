+PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS archive_metadata(key TEXT PRIMARY KEY, value TEXT NOT NULL);
+INSERT OR IGNORE INTO archive_metadata VALUES ('schema_version','ayautc.v0.1');
+INSERT OR IGNORE INTO archive_metadata VALUES ('classification','REBUILDABLE_EXACT_PROJECTION');
+CREATE TABLE IF NOT EXISTS source_files(
+ path TEXT PRIMARY KEY, generation INTEGER NOT NULL, committed_offset INTEGER NOT NULL,
+ prefix_sha256 TEXT NOT NULL, line_number INTEGER NOT NULL, context_json TEXT NOT NULL,
+ last_seen_at TEXT NOT NULL, snapshot_length INTEGER NOT NULL, pending_bytes INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS source_lines(
+ id INTEGER PRIMARY KEY, path TEXT NOT NULL, generation INTEGER NOT NULL,
+ byte_offset INTEGER NOT NULL, byte_length INTEGER NOT NULL, line_number INTEGER NOT NULL,
+ sha256 TEXT NOT NULL, raw_json BLOB NOT NULL, record_type TEXT, payload_type TEXT,
+ timestamp TEXT, session_id TEXT, thread_id TEXT, turn_id TEXT,
+ correlation_basis TEXT NOT NULL, parse_error TEXT,
+ UNIQUE(path,generation,byte_offset));
+CREATE INDEX IF NOT EXISTS source_lines_turn ON source_lines(session_id,turn_id);
+-- Rebuildable Observer lookup over the SAME retained source rows. No transcript
+-- copy, session identity, causal link or missing provider ID is manufactured.
+-- IDs here are exact declared payload fields, not IDs parsed out of tool text.
+CREATE VIEW IF NOT EXISTS observer_source_refs AS
+WITH source AS (
+ SELECT *, CASE WHEN json_valid(CAST(raw_json AS TEXT))
+                THEN CAST(raw_json AS TEXT) ELSE '{}' END AS document
+ FROM source_lines
+)
+SELECT id AS source_line_id, path AS source_path, generation AS source_generation,
+ byte_offset, byte_length, line_number, sha256 AS source_sha256,
+ timestamp, record_type, payload_type, session_id, thread_id, turn_id,
+ correlation_basis, parse_error,
+ CASE WHEN json_type(document,'$.payload.prompt_id')='text'
+      THEN nullif(json_extract(document,'$.payload.prompt_id'),'') END AS prompt_id,
+ CASE WHEN json_type(document,'$.payload.trace_id')='text'
+      THEN nullif(json_extract(document,'$.payload.trace_id'),'') END AS trace_id,
+ CASE WHEN json_type(document,'$.payload.span_id')='text'
+      THEN nullif(json_extract(document,'$.payload.span_id'),'') END AS span_id,
