+def admit_aya_utc_reference(db_path, *, project_id, profile_id, archive_path,
+                            source_event, artifact_record, allow_content=False):
+    """Bind an archive message using its existing archive_key and supplied event_id.
+
+    This is the COMPOSITE/AYA_UTC v0.1 adapter binding, not a new source schema.
+    Absent native session, unsupported nonmessage records or uncertain selection
+    remain unresolved; no native ID/correlation is manufactured.
+    """
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    scope = _reference_scope(project_id, profile_id)
+    _reference_json(source_event, 'event_id', 'SOURCE_EVENT')
+    source = source_event.get('source', {})
+    correlation = source_event.get('correlation', {})
+    position = source.get('source_position', {}) if isinstance(source, dict) else {}
+    if not isinstance(position, dict) or position.get('position_kind') != 'COMPOSITE':
+        raise ValueError('aya_utc_reference_invalid')
+    row = _aya_utc_row(archive_path, position.get('components'))
+    if (not _identity(row['session_id']) or row['parse_error'] is not None or
+            len(row['messages']) != 1):
+        raise ValueError('aya_utc_source_unresolved')
+    native = row['messages'][0]
+    if (not isinstance(correlation, dict) or
+            source.get('source_stream_id') != row['source_path'] or
+            source.get('source_instance_id') != str(row['source_generation']) or
+            source.get('native_event_id') != native['native_message_id'] or
+            position.get('locator') != row['source_path'] or
+            not isinstance(source.get('source_id'), str) or not source['source_id'] or
+            correlation.get('session_id') != row['session_id'] or
+            any(correlation.get(k) is not None and correlation[k] != row[k]
+                for k in ('turn_id', 'trace_id', 'span_id'))):
+        raise ValueError('reference_source_mismatch')
+    times = source_event.get('time', {})
+    if not isinstance(times, dict) or times.get('occurred_at') != row['timestamp']:
+        raise ValueError('reference_source_mismatch')
+    try:
+        observed = datetime.fromisoformat(times['observed_at'].replace('Z', '+00:00'))
+        if observed.utcoffset() != timezone.utc.utcoffset(observed):
+            raise ValueError()
+        captured_at = observed.timestamp()
+        if not math.isfinite(captured_at) or captured_at < 0:
+            raise ValueError()
+    except (KeyError, AttributeError, TypeError, ValueError) as exc:
+        raise ValueError('candidate_time_invalid') from exc
+    # The native archive owns this key. Do not create another occurrence key.
+    source_key = native['archive_key']
+    expected = (*scope, row['session_id'], source_key, str(row['source_generation']),
+                row['source_path'], str(row['byte_offset']), row['source_sha256'], captured_at)
+    con = _connect(db_path)
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        prior = con.execute('''SELECT * FROM source_events WHERE project_id=?
+            AND profile_id=? AND session_id=? AND source_key=?''', expected[:4]).fetchone()
+        if prior is None:
+            con.execute('INSERT INTO source_events VALUES(?,?,?,?,?,?,?,?,?)', expected)
+        elif prior != expected:
+            raise ValueError('source_changed_on_replay')
+        con.commit()
+    except Exception:
+        con.rollback()
+        raise
+    finally:
+        con.close()
+    return admit_reference(db_path, project_id=project_id, profile_id=profile_id,
+        source_key=source_key, source_event=source_event, artifact_record=artifact_record,
+        allow_content=True)
+
+
+def resolve_aya_utc_source(archive_path, coordinates, *, utc_start=None, utc_end=None,
+                           allow_content=False):
+    """Resolve exact retained bytes and independently check today's source file.
+
+    UTC windows are half-open eligibility filters, never joins or causal proof.
+    The archive generation/prefix defines the source contract's change detection.
+    """
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    result = {'artifact_state': 'unresolved_artifact', 'source_state': 'unresolved_source'}
+    try:
+        row = _aya_utc_row(archive_path, coordinates)
+    except ValueError as exc:
+        states = {'db_missing': 'missing_artifact',
+                  'aya_utc_source_unresolved': 'unresolved_artifact',
+                  'aya_utc_reference_changed': 'changed_artifact',
+                  'aya_utc_artifact_changed': 'changed_artifact'}
+        if str(exc) not in states:
+            raise
+        result['artifact_state'] = states[str(exc)]
+        return result
+    except FileNotFoundError:
+        result['artifact_state'] = 'missing_artifact'
+        return result
+    except OSError:
+        result['artifact_state'] = 'unavailable_artifact'
+        return result
+    def utc(value):
+        try:
+            parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
+            if parsed.utcoffset() != timezone.utc.utcoffset(parsed):
+                raise ValueError()
+            return parsed
+        except (TypeError, AttributeError, ValueError) as exc:
+            raise ValueError('aya_utc_time_invalid') from exc
+    start = utc(utc_start) if utc_start is not None else None
+    end = utc(utc_end) if utc_end is not None else None
+    if start is not None and end is not None and end <= start:
+        raise ValueError('aya_utc_time_invalid')
+    if start is not None or end is not None:
+        if row['timestamp'] is None:
+            result['artifact_state'] = 'unresolved_time'
+            return result
+        occurred = utc(row['timestamp'])
+        if (start is not None and occurred < start) or (end is not None and occurred >= end):
+            result['artifact_state'] = 'outside_time_range'
+            return result
+    result.update(artifact_state='verified', content=row['raw_json'],
+        archive_messages=row['messages'], reference={k: v for k, v in row.items() if k not in ('raw_json', 'messages', 'current_file')})
+    current = row['current_file']
+    if current is None:
+        return result
+    if current['generation'] != row['source_generation']:
+        result['source_state'] = 'changed_source'
+        return result
+    import hashlib
+    path = Path(row['source_path'])
+    try:
+        # Read-only file open; no process, ingest, adapter dispatch or source write.
+        with path.open('rb') as file:
+            prefix = hashlib.sha256()
+            left = current['committed_offset']
+            while left:
+                part = file.read(min(left, 65536))
+                if not part:
+                    result['source_state'] = 'changed_source'
+                    return result
+                prefix.update(part)
+                left -= len(part)
+            file.seek(row['byte_offset'])
+            raw = file.read(row['byte_length'])
+        unchanged = (prefix.hexdigest() == current['prefix_sha256'] and raw == row['raw_json'])
+        result['source_state'] = 'verified' if unchanged else 'changed_source'
+    except FileNotFoundError:
+        result['source_state'] = 'missing_source'
+    except OSError:
+        result['source_state'] = 'unavailable_source'
+    return result
+
+
+def resolve_aya_utc_reference(db_path, *, project_id, profile_id, event_id,
+                              archive_path, utc_start=None, utc_end=None, allow_content=False):
+    """Resolve an admitted Observer reference through the existing AYA_UTC rows."""
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    history = reference_history(db_path, project_id=project_id, profile_id=profile_id,
+                                event_id=event_id, allow_content=True)
+    source = history['source_event']['source']
+    position = source['source_position']
+    if position.get('position_kind') != 'COMPOSITE':
+        raise ValueError('aya_utc_reference_invalid')
+    result = resolve_aya_utc_source(archive_path, position.get('components'),
+        utc_start=utc_start, utc_end=utc_end, allow_content=True)
+    artifact = history['artifact_record']
+    result.update(event_id=event_id, artifact_id=artifact['artifact_id'])
+    if result['artifact_state'] == 'verified':
+        import hashlib
+        reference = result['reference']
+        correlation = history['source_event'].get('correlation', {})
+        valid = (result.get('archive_messages') == [{'archive_key': history['source_key'],
+                    'native_message_id': source.get('native_event_id')}] and
+                 hashlib.sha256(result['content']).hexdigest() == artifact['content_digest']['value'] and
+                 len(result['content']) == artifact['size_bytes'] and
+                 all(correlation.get(k) is None or correlation[k] == reference[k] for k in
+                     ('session_id', 'turn_id', 'trace_id', 'span_id')) and
+                 history['source_event']['time'].get('occurred_at') == reference['timestamp'])
+        if not valid:
+            result['artifact_state'] = 'changed_artifact'
+            result.pop('content', None)
+    return result
+
+
 if __name__ == '__main__':
     sys.exit(main())
