+def admit_reference(db_path, *, project_id, profile_id, source_key, source_event,
+                    artifact_record, allow_content=False):
+    """Bind supplied Observer occurrence/custody to already captured metadata.
+
+    Only the current Hermes ROW_PRIMARY_KEY binding is supported. Full caller
+    records are retained unchanged; validation is not writer-provenance admission.
+    No ID is issued and neither a source digest nor content equality dedupes.
+    """
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    scope = _reference_scope(project_id, profile_id)
+    source_json = _reference_json(source_event, 'event_id', 'SOURCE_EVENT')
+    artifact_json = _reference_json(artifact_record, 'artifact_id')
+    source = source_event.get('source', {})
+    correlation = source_event.get('correlation', {})
+    capture = artifact_record.get('capture', {})
+    digest = artifact_record.get('content_digest', {})
+    if (not all(isinstance(x, dict) for x in (source, correlation, capture, digest)) or
+            not isinstance(source.get('source_position'), dict) or
+            not _identity(source.get('sequence_epoch')) or
+            digest.get('algorithm') != 'sha256' or
+            not isinstance(digest.get('value'), str) or not _HEX.fullmatch(digest['value']) or
+            type(artifact_record.get('size_bytes')) is not int or artifact_record['size_bytes'] < 0 or
+            not isinstance(artifact_record.get('storage_object_ref'), str) or
+            not artifact_record['storage_object_ref'] or
+            capture.get('source_event_id') != source_event['event_id'] or
+            source_event.get('artifact_ids') != [artifact_record['artifact_id']] or
+            not isinstance(source_key, str)):
+        raise ValueError('reference_binding_invalid')
+    con = _connect(db_path, require_existing=True)
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        staged = con.execute('''SELECT session_id, source_generation_id, source_path,
+            source_position FROM source_events WHERE project_id=? AND profile_id=?
+            AND source_key=?''', (*scope, source_key)).fetchall()
+        position = source['source_position']
+        hermes = (source.get('source_id') == 'hermes' and
+                  source.get('source_stream_id') == 'messages' and
+                  position.get('position_kind') == 'ROW_PRIMARY_KEY' and
+                  len(staged) == 1 and
+                  (correlation.get('session_id'), source.get('source_instance_id'),
+                   position.get('locator'), source.get('native_event_id')) == staged[0] and
+                  position.get('row_primary_key') == staged[0][3])
+        components = position.get('components', {})
+        aya_utc = (source_key.startswith('ayautc:') and len(staged) == 1 and
+                   position.get('position_kind') == 'COMPOSITE' and isinstance(components, dict) and
+                   (correlation.get('session_id'), source.get('source_instance_id'),
+                    position.get('locator'), str(components.get('byte_offset'))) == staged[0] and
+                   components.get('source_path') == staged[0][2] and
+                   str(components.get('source_generation')) == staged[0][1] and
+                   source.get('source_stream_id') == staged[0][2])
+        if not (hermes or aya_utc):
+            raise ValueError('reference_source_mismatch')
+        _reference_tables(con)
+        if con.execute('''SELECT 1 FROM reference_interpretations
+            WHERE project_id=? AND profile_id=? AND event_id=?''',
+            (*scope, source_event['event_id'])).fetchone():
+            raise ValueError('reference_event_id_conflict')
+        rows = con.execute('''SELECT event_id,source_key,source_json,artifact_json
+            FROM reference_sources WHERE project_id=? AND profile_id=?
+            AND (event_id=? OR (source_key=? AND sequence_epoch=?))''',
+            (*scope, source_event['event_id'], source_key, source['sequence_epoch'])).fetchall()
+        expected = (source_event['event_id'], source_key, source_json, artifact_json)
+        if rows == [expected]:
+            state = 'replayed'
+        elif rows:
+            raise ValueError('reference_changed_on_replay')
+        else:
+            # Artifact identity also stays occurrence-specific, never digest-specific.
+            for (body,) in con.execute('''SELECT artifact_json FROM reference_sources
+                    WHERE project_id=? AND profile_id=?''', scope):
+                if json.loads(body)['artifact_id'] == artifact_record['artifact_id']:
+                    raise ValueError('reference_artifact_id_conflict')
+            con.execute('INSERT INTO reference_sources VALUES(?,?,?,?,?,?,?)',
+                        (*scope, *expected, source['sequence_epoch']))
+            state = 'new'
+        con.commit()
+        return {'state': state, 'event_id': source_event['event_id'], 'status': 'candidate_reference'}
+    except Exception:
+        con.rollback()
+        raise
+    finally:
+        con.close()
+
