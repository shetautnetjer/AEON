+def _aya_utc_row(archive_path, coordinates):
+    """Read the existing archive/view without ingestion, schema writes or ID issue."""
+    required = {'source_path', 'source_generation', 'byte_offset', 'byte_length',
+                'line_number', 'source_sha256'}
+    if (not isinstance(coordinates, dict) or not required.issubset(coordinates) or
+            not isinstance(coordinates['source_path'], str) or
+            not Path(coordinates['source_path']).is_absolute() or
+            not all(type(coordinates[k]) is int and coordinates[k] >= 0
+                    for k in ('source_generation', 'byte_offset', 'byte_length', 'line_number')) or
+            coordinates['byte_length'] == 0 or coordinates['line_number'] == 0 or
+            not isinstance(coordinates['source_sha256'], str) or
+            not _HEX.fullmatch(coordinates['source_sha256'])):
+        raise ValueError('aya_utc_reference_invalid')
+    con = _connect(archive_path, read_only=True)
+    try:
+        con.row_factory = sqlite3.Row
+        objects = {r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type IN ('table','view')")}
+        if not {'archive_metadata', 'observer_source_refs', 'source_lines', 'source_files', 'messages'}.issubset(objects):
+            raise ValueError('aya_utc_schema_unbound')
+        version = con.execute("SELECT value FROM archive_metadata WHERE key='schema_version'").fetchone()
+        if version is None or version[0] != 'ayautc.v0.1':
+            raise ValueError('aya_utc_schema_unbound')
+        rows = con.execute('''SELECT r.*,s.raw_json FROM observer_source_refs r
+            JOIN source_lines s ON s.id=r.source_line_id
+            WHERE r.source_path=? AND r.source_generation=? AND r.byte_offset=?''',
+            tuple(coordinates[k] for k in ('source_path', 'source_generation', 'byte_offset'))).fetchall()
+        if len(rows) != 1:
+            raise ValueError('aya_utc_source_unresolved')
+        row = dict(rows[0])
+        if any(k not in row or row[k] != v for k, v in coordinates.items()):
+            raise ValueError('aya_utc_reference_changed')
+        import hashlib
+        raw = row['raw_json']
+        if (not isinstance(raw, bytes) or len(raw) != row['byte_length'] or
+                hashlib.sha256(raw).hexdigest() != row['source_sha256']):
+            raise ValueError('aya_utc_artifact_changed')
+        messages = con.execute('''SELECT archive_key,native_message_id FROM messages
+            WHERE source_line_id=?''', (row['source_line_id'],)).fetchall()
+        row['messages'] = [dict(r) for r in messages]
+        current = con.execute('''SELECT generation,committed_offset,prefix_sha256
+            FROM source_files WHERE path=?''', (row['source_path'],)).fetchone()
+        row['current_file'] = dict(current) if current else None
+        return row
+    finally:
+        con.close()
+
