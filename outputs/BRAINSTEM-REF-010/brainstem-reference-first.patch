+def admit_capture_reference(db_path, *, project_id, profile_id, checkpoint,
+                            source_event, artifact_record, allow_content=False):
+    """Join the actual Rust checkpoint to a supplied canonical Observer event.
+
+    Canonical ID issuance remains upstream. The native tuple must select exactly
+    one checkpoint row; native IDs are never inferred from content or time.
+    Metadata capture and reference binding are separate idempotent operations.
+    """
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    profile, session, generation, records = _validated(checkpoint)
+    _reference_json(source_event, 'event_id', 'SOURCE_EVENT')
+    source = source_event.get('source', {})
+    correlation = source_event.get('correlation', {})
+    if (not isinstance(source, dict) or not isinstance(correlation, dict) or
+            profile != profile_id or correlation.get('session_id') != session or
+            source.get('source_instance_id') != generation):
+        raise ValueError('reference_source_mismatch')
+    selected = [key for key, position, _, _ in records
+                if position == source.get('native_event_id')]
+    if len(selected) != 1:
+        raise ValueError('reference_source_unresolved')
+    ingest_capture(db_path, project_id=project_id, checkpoint=checkpoint)
+    return admit_reference(db_path, project_id=project_id, profile_id=profile_id,
+        source_key=selected[0], source_event=source_event, artifact_record=artifact_record,
+        allow_content=True)
+
