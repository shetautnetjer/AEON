+def reference_history(db_path, *, project_id, profile_id, event_id, allow_content=False):
+    """Read frozen source, artifact custody and all additive interpretations."""
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    scope = _reference_scope(project_id, profile_id)
+    con = _connect(db_path, read_only=True)
+    try:
+        if not con.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='reference_sources'").fetchone():
+            raise ValueError('reference_missing')
+        row = con.execute('''SELECT source_key,source_json,artifact_json FROM reference_sources
+            WHERE project_id=? AND profile_id=? AND event_id=?''', (*scope, event_id)).fetchone()
+        if row is None:
+            raise ValueError('reference_missing')
+        # JSON UUIDv7 ordering is not used as native source or causal order.
+        evidence = con.execute('''SELECT evidence_json,supersedes_event_id
+            FROM reference_interpretations WHERE project_id=? AND profile_id=?
+            AND source_event_id=? ORDER BY rowid''', (*scope, event_id)).fetchall()
+        return {'source_key': row[0], 'source_event': json.loads(row[1]),
+                'artifact_record': json.loads(row[2]),
+                'interpretations': [{'evidence_event': json.loads(e), 'supersedes_event_id': p}
+                                    for e, p in evidence]}
+    finally:
+        con.close()
+
