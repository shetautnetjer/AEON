+def link_candidate_reference(db_path, *, project_id, profile_id, save_id, evidence_event_id):
+    """Associate an existing unverified save; never create/promote a memory."""
+    scope = _reference_scope(project_id, profile_id)
+    if not all(isinstance(v, str) and _UUID7.fullmatch(v) for v in (save_id, evidence_event_id)):
+        raise ValueError('reference_link_invalid')
+    con = _connect(db_path, require_existing=True)
+    try:
+        con.execute('BEGIN IMMEDIATE')
+        _reference_tables(con)
+        if not con.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='candidate_saves'").fetchone():
+            raise ValueError('reference_link_mismatch')
+        save = con.execute('''SELECT source_key,status FROM candidate_saves WHERE project_id=?
+            AND profile_id=? AND save_id=?''', (*scope, save_id)).fetchone()
+        reference = con.execute('''SELECT s.source_key FROM reference_sources s
+            JOIN reference_interpretations e ON e.project_id=s.project_id
+            AND e.profile_id=s.profile_id AND e.source_event_id=s.event_id
+            WHERE e.project_id=? AND e.profile_id=? AND e.event_id=?''',
+            (*scope, evidence_event_id)).fetchone()
+        if save is None or reference != (save[0],) or save[1] != 'candidate_unverified':
+            raise ValueError('reference_link_mismatch')
+        prior = con.execute('''SELECT save_id,evidence_event_id FROM candidate_reference_links
+            WHERE project_id=? AND profile_id=? AND (save_id=? OR evidence_event_id=?)''',
+            (*scope, save_id, evidence_event_id)).fetchall()
+        if prior == [(save_id, evidence_event_id)]:
+            state = 'replayed'
+        elif prior:
+            raise ValueError('reference_link_changed')
+        else:
+            con.execute('INSERT INTO candidate_reference_links VALUES(?,?,?,?)',
+                        (*scope, save_id, evidence_event_id))
+            state = 'new'
+        con.commit()
+        return {'state': state, 'status': 'candidate_unverified'}
+    except Exception:
+        con.rollback()
+        raise
+    finally:
+        con.close()
