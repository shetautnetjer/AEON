+//! Offline fixture-only SourceEvent acceptance. The journal is the recovery authority.
+//! No daemon, production authority registration, EvidenceEvent or memory promotion.
+use chrono::{DateTime, FixedOffset, SecondsFormat, Utc};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::HashSet,
+    fs::{self, File, OpenOptions},
+    io::{Read, Seek, SeekFrom, Write},
+    os::{
+        fd::AsRawFd,
+        unix::fs::{MetadataExt, OpenOptionsExt},
+    },
+    path::Path,
+    time::{SystemTime, UNIX_EPOCH},
+};
+use uuid::Uuid;
+
+fn text<'a>(v: &'a Value, key: &str) -> Result<&'a str, String> {
+    v.get(key)
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty() && s.len() <= 1024)
+        .ok_or_else(|| "admission_input_invalid".into())
+}
+fn digest(v: &Value) -> String {
+    format!("{:x}", Sha256::digest(serde_json::to_vec(v).unwrap()))
+}
+fn hex(v: &str) -> bool {
+    v.len() == 64
+        && v.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn identity(v: &str) -> bool {
+    !v.is_empty()
+        && v.len() <= 128
+        && v.bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"_.:-".contains(&b))
+}
+
+fn validate(req: &Value) -> Result<Vec<String>, String> {
+    let object = req.as_object().ok_or("admission_input_invalid")?;
+    if object.len() != 4 || req["fixture_only"] != true {
+        return Err("fixture_scope_required".into());
+    }
+    let event = &req["source_event"];
+    let source = &event["source"];
+    let position = &source["source_position"];
+    let captured = &req["captured_record"];
+    let env = &captured["envelope"];
+    let native = &env["source"];
+    let generation = text(native, "source_generation_id")?;
+    let profile = text(env, "profile_id")?;
+    let session = text(native, "source_instance_id")?;
+    let row = text(native, "native_event_id")?;
+    let sha = text(&env["capture"], "record_sha256")?;
+    let path = text(req, "source_path")?;
+    if !hex(generation)
+        || !hex(sha)
+        || !identity(profile)
+        || !identity(session)
+        || row
+            .parse::<u64>()
+            .ok()
+            .filter(|n| *n > 0 && n.to_string() == row)
+            .is_none()
+        || !Path::new(path).is_absolute()
+        || native["producer_id"] != "hermes"
+        || native["source_stream_id"] != "messages"
+        || native["source_position"] != row
+        || env["correlation"] != json!({"session_id":session})
+        || env["payload"] != json!({})
+        || env["semantics"] != json!({})
+        || env["evidence_refs"] != json!([])
+        || env["capture"]["captured_at"]
+            .as_f64()
+            .filter(|t| t.is_finite() && *t >= 0.0)
+            .is_none()
+        || captured["source_key"]
+            != format!("{profile}/hermes/{generation}/{session}/messages/{row}")
+    {
+        return Err("capture_binding_invalid".into());
+    }
+    if event["record_kind"] != "SOURCE_EVENT"
+        || event["schema_version"] != "0.2"
+        || event["source_context_class"] != "PRE_OBSERVER_SOURCE_CONTEXT"
+        || event["capture_mode"] != "HISTORICAL_IMPORT"
+        || event.get("event_id").is_some()
+        || event["time"].get("ingested_at").is_some()
+        || event["observer"].get("observer_sequence").is_some()
+        || source["source_id"] != "hermes"
+        || source["source_kind"] != "HERMES"
+        || source["source_instance_id"] != generation
+        || source["source_stream_id"] != "messages"
+        || source["native_event_id"] != row
+        || position["position_kind"] != "ROW_PRIMARY_KEY"
+        || position["row_primary_key"] != row
+        || position["locator"] != path
+        || event["correlation"]["session_id"] != session
+        || event["correlation"]["runtime_profile_id"] != profile
+        || event["payload"]["record_sha256"] != sha
+        || event["capture"]
+            != json!({"capture_policy":"NORMAL","content_disposition":"METADATA_ONLY"})
+        || !event["artifact_ids"].is_array()
+        || !event["origin"].is_object()
+        || !event["coverage"]["gap_refs"].is_array()
+        || !event["coverage"]["limitations"].is_array()
+        || !matches!(
+            event["coverage"]["status"].as_str(),
+            Some("COMPLETE" | "PARTIAL" | "GAP_KNOWN" | "COVERAGE_UNKNOWN")
+        )
+    {
+        return Err("source_event_template_invalid".into());
+    }
+    for (v, k) in [
+        (event, "event_type"),
+        (source, "adapter_id"),
+        (source, "adapter_version"),
+        (&event["time"], "observed_at"),
+    ] {
+        text(v, k)?;
+    }
+    let observed = utc_time(text(&event["time"], "observed_at")?)?;
+    let captured_at = env["capture"]["captured_at"].as_f64().unwrap();
+    let observed_seconds =
+        observed.timestamp() as f64 + f64::from(observed.timestamp_subsec_nanos()) / 1e9;
+    if (observed_seconds - captured_at).abs() > 0.000001 {
+        return Err("capture_time_binding_invalid".into());
+    }
+    if let Some(occurred) = event["time"].get("occurred_at").filter(|v| !v.is_null()) {
+        utc_time(occurred.as_str().ok_or("source_time_invalid")?)?;
+    }
+    if event["payload"] != json!({"record_sha256": sha}) {
+        return Err("metadata_capture_policy_invalid".into());
+    }
+    let epoch = text(source, "sequence_epoch")?;
+    if !identity(epoch) {
+        return Err("source_epoch_invalid".into());
+    }
+    let writer = &event["observer"];
+    if !text(writer, "observer_instance_id")?.starts_with("fixture-")
+        || !text(writer, "writer_actor_id")?.starts_with("fixture-")
+        || !text(writer, "writer_authority_receipt_ref")?.starts_with("fixture:")
+        || event["correlation"].get("actor_id") == writer.get("writer_actor_id")
+    {
+        return Err("fixture_writer_provenance_invalid".into());
+    }
+    for id in event["artifact_ids"].as_array().unwrap() {
+        let id = Uuid::parse_str(id.as_str().ok_or("artifact_id_invalid")?)
+            .map_err(|_| "artifact_id_invalid")?;
+        if id.get_version_num() != 7 {
+            return Err("artifact_id_invalid".into());
+        }
+    }
+    Ok(vec![
+        "hermes".into(),
+        generation.into(),
+        "messages".into(),
+        epoch.into(),
+        row.into(),
+    ])
+}
+
+fn utc_time(value: &str) -> Result<DateTime<FixedOffset>, String> {
+    let parsed = DateTime::parse_from_rfc3339(value).map_err(|_| "source_time_invalid")?;
+    if parsed.offset().local_minus_utc() != 0 {
+        return Err("source_time_invalid".into());
+    }
+    Ok(parsed)
+}
+fn utc_now() -> Result<String, String> {
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| "clock_invalid")?;
+    let seconds = now.as_secs().try_into().map_err(|_| "clock_invalid")?;
+    let timestamp: DateTime<Utc> =
+        DateTime::from_timestamp(seconds, now.subsec_nanos()).ok_or("clock_invalid")?;
+    Ok(timestamp.to_rfc3339_opts(SecondsFormat::Nanos, true))
+}
+fn crash(stage: &str) {
+    // Only this explicit fixture admission API observes the failure-injection flag.
+    if std::env::var("BRAINSTEM_FIXTURE_CRASH").ok().as_deref() == Some(stage) {
+        std::process::exit(86);
+    }
+}
+struct Locked(File);
+impl Drop for Locked {
+    fn drop(&mut self) {
+        unsafe {
+            libc::flock(self.0.as_raw_fd(), libc::LOCK_UN);
+        }
+    }
+}
+fn open(path: &Path) -> Result<Locked, String> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|c| matches!(c, std::path::Component::ParentDir))
+        || path.ancestors().any(|p| p.is_symlink())
+    {
+        return Err("journal_path_invalid".into());
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)
+        .map_err(|_| "journal_open_failed")?;
+    let meta = file.metadata().map_err(|_| "journal_open_failed")?;
+    if !meta.is_file() || meta.mode() & 0o077 != 0 {
+        return Err("journal_not_private_regular".into());
+    }
+    if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+        return Err("journal_locked".into());
+    }
+    let locked = Locked(file);
+    let named = fs::symlink_metadata(path).map_err(|_| "journal_path_changed")?;
+    if (named.dev(), named.ino()) != (meta.dev(), meta.ino()) {
+        return Err("journal_path_changed".into());
+    }
+    // Repeating this harmless directory sync also covers a creator crash before sync.
+    File::open(path.parent().ok_or("journal_path_invalid")?)
+        .and_then(|p| p.sync_all())
+        .map_err(|_| "journal_directory_sync_failed")?;
+    Ok(locked)
+}
+
+/// Admit only the fixture capture profile. Returns acknowledgment only after sync.
+/// Intact unacknowledged frames are recovered without assigning another event ID.
+pub fn accept_fixture(path: &Path, request: &Value) -> Result<Value, String> {
+    let tuple = validate(request)?;
+    let mut locked = open(path)?;
+    let journal = &mut locked.0;
+    let size = journal.metadata().map_err(|_| "journal_read_failed")?.len();
+    if size > 8 * 1024 * 1024 {
+        return Err("fixture_journal_limit".into());
+    }
+    let mut bytes = Vec::new();
+    journal
+        .read_to_end(&mut bytes)
+        .map_err(|_| "journal_read_failed")?;
+    let complete = bytes.iter().rposition(|b| *b == b'\n').map_or(0, |i| i + 1);
+    let mut count = 0u64;
+    let mut ids = HashSet::new();
+    let mut tuples = HashSet::new();
+    let mut replay = None;
+    let mut writer: Option<Value> = None;
+    for line in bytes[..complete].split_inclusive(|b| *b == b'\n') {
+        let mut frame: Value = serde_json::from_slice(line).map_err(|_| "journal_corrupt")?;
+        let seal = frame
+            .as_object_mut()
+            .ok_or("journal_corrupt")?
+            .remove("seal")
+            .ok_or("journal_corrupt")?;
+        if seal != digest(&frame) || frame["version"] != 1 || frame["fixture_only"] != true {
+            return Err("journal_corrupt".into());
+        }
+        let original = &frame["request"];
+        let native = validate(original).map_err(|_| "journal_corrupt")?;
+        let event = &frame["source_event"];
+        count += 1;
+        let event_id = Uuid::parse_str(text(event, "event_id").map_err(|_| "journal_corrupt")?)
+            .map_err(|_| "journal_corrupt")?;
+        if event_id.get_version_num() != 7
+            || !ids.insert(event_id)
+            || !tuples.insert(native.clone())
+            || event["observer"]["observer_sequence"] != count
+            || text(&event["time"], "ingested_at")
+                .and_then(utc_time)
+                .is_err()
+        {
+            return Err("journal_corrupt".into());
+        }
+        let mut template = event.clone();
+        template
+            .as_object_mut()
+            .ok_or("journal_corrupt")?
+            .remove("event_id");
+        template["time"]
+            .as_object_mut()
+            .ok_or("journal_corrupt")?
+            .remove("ingested_at");
+        template["observer"]
+            .as_object_mut()
+            .ok_or("journal_corrupt")?
+            .remove("observer_sequence");
+        if template != original["source_event"] {
+            return Err("journal_corrupt".into());
+        }
+        if let Some(ref w) = writer {
+            if w != &template["observer"] {
+                return Err("journal_corrupt".into());
+            }
+        } else {
+            writer = Some(template["observer"].clone());
+        }
+        if native == tuple {
+            if original != request {
+                return Err("occurrence_rebinding_rejected".into());
+            }
+            replay = Some(event.clone());
+        }
+    }
+    if writer
+        .as_ref()
+        .is_some_and(|w| w != &request["source_event"]["observer"])
+    {
+        return Err("journal_writer_rebinding_rejected".into());
+    }
+    // Validate every complete frame before repairing any unaccepted trailing write.
+    if complete < bytes.len() {
+        journal
+            .set_len(complete as u64)
+            .map_err(|_| "journal_recovery_failed")?;
+    }
+    journal.sync_all().map_err(|_| "journal_sync_failed")?;
+    if let Some(event) = replay {
+        return Ok(json!({"state":"replayed","fixture_only":true,"source_event":event}));
+    }
+    let mut event = request["source_event"].clone();
+    event["event_id"] = json!(Uuid::now_v7().to_string());
+    event["time"]["ingested_at"] = json!(utc_now()?);
+    event["observer"]["observer_sequence"] = json!(count + 1);
+    let mut frame = json!({"version":1,"fixture_only":true,"request":request,"source_event":event});
+    frame["seal"] = json!(digest(&frame));
+    let mut encoded = serde_json::to_vec(&frame).map_err(|_| "journal_encode_failed")?;
+    encoded.push(b'\n');
+    if complete + encoded.len() > 8 * 1024 * 1024 {
+        return Err("fixture_journal_limit".into());
+    }
+    journal
+        .seek(SeekFrom::End(0))
+        .map_err(|_| "journal_write_failed")?;
+    crash("before_append");
+    if std::env::var("BRAINSTEM_FIXTURE_CRASH").ok().as_deref() == Some("partial_frame") {
+        journal
+            .write_all(&encoded[..encoded.len() / 2])
+            .map_err(|_| "journal_write_failed")?;
+        crash("partial_frame");
+    }
+    journal
+        .write_all(&encoded)
+        .map_err(|_| "journal_write_failed")?;
+    crash("after_append");
+    journal.sync_all().map_err(|_| "journal_sync_failed")?;
+    crash("after_sync");
+    Ok(json!({"state":"new","fixture_only":true,"source_event":event}))
+}
