+def _reference_tables(con):
+    columns = {r[1] for r in con.execute('PRAGMA table_info(reference_sources)')}
+    if columns and 'sequence_epoch' not in columns:
+        raise ValueError('reference_schema_unbound')
+    con.execute('''CREATE TABLE IF NOT EXISTS reference_sources (
+        project_id TEXT NOT NULL, profile_id TEXT NOT NULL, event_id TEXT NOT NULL,
+        source_key TEXT NOT NULL, source_json TEXT NOT NULL, artifact_json TEXT NOT NULL,
+        sequence_epoch TEXT NOT NULL,
+        PRIMARY KEY(project_id,profile_id,event_id),
+        UNIQUE(project_id,profile_id,source_key,sequence_epoch))''')
+    con.execute('''CREATE TABLE IF NOT EXISTS reference_interpretations (
+        project_id TEXT NOT NULL, profile_id TEXT NOT NULL, event_id TEXT NOT NULL,
+        source_event_id TEXT NOT NULL, evidence_json TEXT NOT NULL, supersedes_event_id TEXT,
+        PRIMARY KEY(project_id,profile_id,event_id),
+        UNIQUE(project_id,profile_id,supersedes_event_id))''')
+    con.execute('''CREATE TABLE IF NOT EXISTS candidate_reference_links (
+        project_id TEXT NOT NULL, profile_id TEXT NOT NULL, save_id TEXT NOT NULL,
+        evidence_event_id TEXT NOT NULL,
+        PRIMARY KEY(project_id,profile_id,save_id),
+        UNIQUE(project_id,profile_id,evidence_event_id))''')
+
