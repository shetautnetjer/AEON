+# Reference-first bindings are a candidate projection, not an Observer writer.
+def _reference_json(record, id_field, kind=None):
+    if (not isinstance(record, dict) or
+            not isinstance(record.get(id_field), str) or
+            not _UUID7.fullmatch(record[id_field]) or record.get('schema_version') != '0.2' or
+            (kind is not None and record.get('record_kind') != kind)):
+        raise ValueError('reference_record_invalid')
+    try:
+        return json.dumps(record, sort_keys=True, separators=(',', ':'), allow_nan=False)
+    except (TypeError, ValueError) as exc:
+        raise ValueError('reference_record_invalid') from exc
+
+
+def _reference_scope(project_id, profile_id):
+    if not _identity(project_id) or not _identity(profile_id):
+        raise ValueError('source_scope_invalid')
+    return project_id, profile_id
+
