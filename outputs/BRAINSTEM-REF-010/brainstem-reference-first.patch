+def resolve_reference(db_path, *, project_id, profile_id, event_id,
+                      artifact_reader, source_reader, allow_content=False):
+    """Reopen retained artifact bytes and separately check today's native source.
+
+    Readers are explicit adapter dependencies. source_reader receives the frozen
+    SourceEvent and returns (source_instance_id, exact hashed native bytes).
+    A changed generation is changed_source even when bytes are identical.
+    """
+    if not allow_content:
+        raise ValueError('content_not_authorized')
+    import hashlib
+    history = reference_history(db_path, project_id=project_id, profile_id=profile_id, event_id=event_id, allow_content=True)
+    artifact = history['artifact_record']
+    con = _connect(db_path, read_only=True)
+    try:
+        row = con.execute('''SELECT record_sha256 FROM source_events WHERE project_id=?
+            AND profile_id=? AND source_key=?''',
+            (project_id, profile_id, history['source_key'])).fetchone()
+        if row is None:
+            raise ValueError('reference_source_missing')
+        source_digest = row[0]
+    finally:
+        con.close()
+    result = {'event_id': event_id, 'artifact_id': artifact['artifact_id']}
+    for kind, reader, ref, digest, size in (
+            ('artifact', artifact_reader, artifact['storage_object_ref'], artifact['content_digest']['value'], artifact['size_bytes']),
+            ('source', source_reader, history['source_event'], source_digest, None)):
+        try:
+            data = reader(ref)
+            if kind == 'source':
+                if not isinstance(data, tuple) or len(data) != 2:
+                    raise TypeError('reference_reader_generation_required')
+                generation, data = data
+                if generation != history['source_event']['source']['source_instance_id']:
+                    result['source_state'] = 'changed_source'
+                    continue
+            if not isinstance(data, bytes):
+                raise TypeError('reference_reader_bytes_required')
+            valid = hashlib.sha256(data).hexdigest() == digest and (size is None or len(data) == size)
+            result[kind + '_state'] = 'verified' if valid else 'changed_' + kind
+            if kind == 'artifact' and valid:
+                result['content'] = data
+        except FileNotFoundError:
+            result[kind + '_state'] = 'missing_' + kind
+        except OSError:
+            result[kind + '_state'] = 'unavailable_' + kind
+    return result
+
